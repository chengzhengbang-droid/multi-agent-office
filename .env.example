# Never commit a real API key. Copy this file to .env and fill in one provider key.
# Several provider keys may coexist: one Pi Agent per provider is supported, and
# the roster editor writes each key separately instead of replacing the others.

# Z.AI / GLM Coding Plan in mainland China
ZAI_CODING_CN_API_KEY=
MAO_PI_PROVIDER=zai-coding-cn
MAO_PI_MODEL=glm-5.2
MAO_PI_THINKING=medium

# New installations can default to pi (built in) or codex (requires Codex CLI).
MAO_DEFAULT_AGENT=pi

# Codex CLI is used for every catalog Agent whose runtime.kind is "codex".
# MAO_CODEX_COMMAND=/absolute/path/to/codex

# Global cap for concurrent read-only Agent runs.
MAO_MAX_PARALLEL_READ_RUNS=4

# How the peer-review gate decides what to review.
#   smart    (default) an Agent declares its own deliverables with complete_task
#            or submit_plan, and a run that writes files is reviewed whether it
#            declared anything or not. Plain conversation is not reviewed.
#   on       review every user task, including greetings and questions.
#   off      no review; a completed run is the final deliverable.
MAO_REVIEW_GATE=smart

# The hard stop on peer discussion. This is a safety cap, not the usual way a
# review ends: a task only reaches it if blocking objections are still being
# raised and answered round after round. Running out of rounds is not itself
# evidence that the peers disagree, so it is deliberately generous.
MAO_MAX_REVIEW_ROUNDS=4

# What actually calls the human: how many rounds in a row may restate the round
# before them before the platform declares a deadlock. 2 means the same
# unanswered objection standing through three rounds ends the discussion.
MAO_REVIEW_STALL_ROUNDS=2

# How long a gate waiting on a human stays fresh in the approval index, in
# hours. Past it the item is marked stale so the badge can say the context has
# moved on. Expiry never decides anything: a stale gate is unanswered, not
# rejected.
MAO_APPROVAL_STALE_HOURS=24

# Local-only HTTP server.
PORT=4173

# For the global Z.AI Coding Plan, use these instead:
# ZAI_API_KEY=
# MAO_PI_PROVIDER=zai

# For DeepSeek's official API, use these instead:
# DEEPSEEK_API_KEY=
# MAO_PI_PROVIDER=deepseek
# MAO_PI_MODEL=deepseek-v4-flash

# MAO_PI_PROVIDER and MAO_PI_MODEL only seed the default @pi Agent on first run.
# A roster with one Pi Agent per provider keeps each Agent's provider in
# .data/agents.json and needs that provider's key present here, for example:
# ZAI_CODING_CN_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# QWEN_TOKEN_PLAN_CN_API_KEY=
# OPENROUTER_API_KEY=

# Every built-in provider the roster editor can configure has its own variable;
# src/config/provider-presets.ts is the full list.

# Third-party and self-hosted deployments are declared in
# .data/custom-providers.json from the roster editor, and their keys land here
# under a generated name, for example a provider with id "my-vllm":
# MAO_CUSTOM_MY_VLLM_API_KEY=
