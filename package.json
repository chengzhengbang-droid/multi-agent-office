{
  "name": "multi-agent-pi-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A platform-owned multi-agent MVP with Pi as a replaceable runtime adapter.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "demo": "node --import tsx src/demo.ts",
    "test": "tsc -p tsconfig.json && node --test dist/test/**/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "typebox": "1.3.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
